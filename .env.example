# Configura estas variables antes del primer arranque con una base nueva.
PANEL_ADMIN_BOOTSTRAP_EMAIL=admin@tu-empresa.example
PANEL_ADMIN_BOOTSTRAP_PASSWORD=cambia-esta-clave-larga

# Ruta local de SQLite. Debe estar en un volumen persistente en despliegue.
PANEL_ADMIN_DB_PATH=data/panel-admin.sqlite

# URL pública exacta para validar el origen de las peticiones POST.
# PANEL_ADMIN_ORIGIN=https://panel.tu-empresa.example
